---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import {
  navigation,
  socialLinks,
  partnerLogos,
  businessHighlights,
  journeySteps,
  mediaItems,
} from '../data/site';

const portraitUrl = '/anchit-goyal-portrait.jpg';
const aboutImageUrl = '/anchit-graduation.webp';
const quoteImageUrl = '/anchit-professional-portrait.webp';
---

<Layout title="Anchit Goyal | Analyst">
  <Preloader />

  <div class="page-shell">
    <header class="header">
      <a class="brand" href="#home" aria-label="Anchit Goyal home">
        <span class="brand-mark">AG</span>
        <span>Anchit Goyal</span>
      </a>

      <nav class="nav" aria-label="Main navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <details class="mobile-nav">
        <summary aria-label="Open navigation menu">
          <span class="mobile-menu-icon" aria-hidden="true">☰</span>
          <span>Menu</span>
        </summary>
        <nav class="mobile-nav-links" aria-label="Mobile navigation">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>

      <a
        class="header-cta"
        href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=anchitgoyal%40voltare.in"
        target="_blank"
        rel="noopener noreferrer"
      >
        Connect
      </a>
    </header>

    <main>
      <section class="hero-panel" id="home" aria-label="Executive hero section">
        <div class="hero-copy">
          <p class="eyebrow"></p>
          <h1>Anchit<br />Goyal</h1>
          <p class="hero-role">Entrepreneur · Recruiter · Researcher · Poet · Photographer · Traveller</p>
          <p>
            An entrepreneur and strategic business leader driving talent transformation,
            strengthening industry connections, and building ventures that turn business
            opportunities into lasting impact.
          </p>
          <div class="signature"></div>
        </div>

        <div class="hero-visual">
          <div class="portrait-frame">
            <img
              src={portraitUrl}
              alt="Portrait of Anchit Goyal"
              width="768"
              height="1024"
              fetchpriority="high"
            />
          </div>

          <div class="social-stack" aria-label="Social profiles">
            {socialLinks.map((item) => (
              <a
                class="icon-badge"
                href={item.href}
                aria-label={`Visit Anchit Goyal on ${item.label}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.icon === 'voltare' ? (
                  <img class="voltare-social-logo" src="/voltare-symbol-burgundy.png" alt="" />
                ) : item.icon === 'instagram' ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle class="instagram-dot" cx="17.5" cy="6.5" r="1" />
                  </svg>
                ) : (
                  <span>{item.icon}</span>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>

      <div class="brand-strip" aria-label="Featured brands">
        {partnerLogos.map((logo) => (
          <a
            class="brand-pill"
            href={logo.href}
            aria-label={`Visit ${logo.name} on Anchit Goyal's LinkedIn`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={logo.src} alt="" loading="lazy" />
          </a>
        ))}
      </div>

      <div class="lower-page">
        <section class="section" id="about" aria-labelledby="about-title">
          <article class="about-card">
            <div class="about-card-image">
              <img
                src={aboutImageUrl}
                alt="Anchit Goyal in his graduation gown at a baseball stadium"
                loading="lazy"
              />
            </div>

            <div class="about-card-content">
              <span class="kicker">About</span>
              <h2 class="section-title about-card-title" id="about-title">
                Economics. Management. Analysis.
              </h2>
              <p class="about-card-lead">
                An entrepreneur and strategic business leader driving talent transformation,
                strengthening industry connections, and building ventures that turn business
                opportunities into lasting impact.
              </p>
              <p class="about-card-description">
                His professional strengths include writing and communication, teamwork and
                leadership, research and analysis, economic theory, and management theory. This
                combination brings together clear communication, collaborative work, and an
                analytical academic foundation.
              </p>
            </div>
          </article>
        </section>

        <section class="section" id="businesses">
          <article class="experience-card">
            <div class="experience-card-photo">
              <img
                src="/expertise-background.webp"
                alt="Anchit Goyal in a suit and sunglasses"
                loading="lazy"
              />
            </div>

            <div class="experience-card-content">
              <div class="experience-group" aria-labelledby="expertise-title">
                <span class="kicker">Areas of expertise</span>
                <h2 class="section-title" id="expertise-title">Skills for thoughtful analysis.</h2>

                <div class="experience-list">
                  {businessHighlights.map((item) => (
                    <article class="experience-item">
                      <div class="experience-item-heading">
                        <h3>{item.name}</h3>
                        <span>{item.role}</span>
                      </div>
                      <p>{item.description}</p>
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        View profile <span aria-hidden="true">↗</span>
                      </a>
                    </article>
                  ))}
                </div>
              </div>

              <div class="experience-group" id="journey" aria-labelledby="background-title">
                <span class="kicker">Professional background</span>
                <h2 class="section-title" id="background-title">
                  A foundation in study and analysis.
                </h2>

                <div class="experience-list">
                  {journeySteps.map((step) => (
                    <article class="experience-item">
                      <span class="experience-item-label">{step.year}</span>
                      <h3>{step.title}</h3>
                      <p>{step.body}</p>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          </article>
        </section>

        <section class="section" id="recognition">
          <div class="section-header">
            <div>
              <span class="kicker">Education &amp; profile</span>
              <h2 class="section-title">A record grounded in academic achievement.</h2>
            </div>
          </div>

          <article class="education-card">
            <div class="education-campuses">
              <figure class="education-campus">
                <img
                  src="/lse-campus.webp"
                  alt="The Old Building at the London School of Economics and Political Science"
                  loading="lazy"
                />
                <figcaption>London School of Economics and Political Science</figcaption>
              </figure>
              <figure class="education-campus">
                <img
                  src="/nyu-campus.webp"
                  alt="New York University flag on campus"
                  loading="lazy"
                />
                <figcaption>New York University</figcaption>
              </figure>
            </div>

            <div class="education-card-content">
              <div class="education-program">
                <span class="education-honour">LSE</span>
                <h3>Economics &amp; Management</h3>
                <p>Bachelor of Science - BA First-Class Honours</p>
              </div>
              <div class="education-program">
                <span class="education-honour">New York University</span>
                <h3>Econometrics and Quantitative Economics</h3>
                <p>Master of Arts - MA</p>
              </div>
            </div>
          </article>
        </section>

        <section class="section approach-section" id="leadership" aria-labelledby="approach-title">
          <div class="approach-layout">
            <div class="approach-photo-frame" data-reveal>
              <img
                src={quoteImageUrl}
                alt="Anchit Goyal, professional portrait"
                width="768"
                height="768"
                loading="lazy"
              />
            </div>

            <div class="approach-content" data-reveal>
              <span class="approach-kicker">Why work with me</span>
              <h2 class="approach-title" id="approach-title">
                Experience you can trust. Clarity you can act on.
              </h2>
              <p class="approach-intro">
                Anchit pairs an economics and management foundation with research-led thinking,
                clear communication, and a collaborative approach to complex business questions.
              </p>

              <div class="approach-pillars" aria-label="How Anchit works">
                <article class="approach-pillar">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 3v3m0 12v3M3 12h3m12 0h3" />
                    <circle cx="12" cy="12" r="7" />
                    <circle cx="12" cy="12" r="2" />
                  </svg>
                  <h3>Strategic thinking</h3>
                  <p>Connect business context to practical next steps.</p>
                </article>

                <article class="approach-pillar">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="10.8" cy="10.8" r="6.8" />
                    <path d="m16 16 4.5 4.5M8 11l1.8 1.8L14 8.5" />
                  </svg>
                  <h3>Research-led insight</h3>
                  <p>Turn complex information into clear direction.</p>
                </article>

                <article class="approach-pillar">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M4 5.5h16v11H9l-5 3v-14Z" />
                    <path d="M8 9h8M8 13h5" />
                  </svg>
                  <h3>Clear communication</h3>
                  <p>Make ideas concise, useful, and actionable.</p>
                </article>

                <article class="approach-pillar">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3.5 19v-1.5a5.5 5.5 0 0 1 11 0V19h-11Zm11-11a3 3 0 1 1 0 6m2 1a4.5 4.5 0 0 1 4 4.5" />
                  </svg>
                  <h3>Collaborative approach</h3>
                  <p>Bring people together around shared outcomes.</p>
                </article>
              </div>

              <div class="approach-stats" aria-label="Professional metrics">
                <div class="approach-stat">
                  <span class="approach-stat-value">CEO</span>
                  <span class="approach-stat-label">Voltare</span>
                </div>
                <div class="approach-stat">
                  <span class="approach-stat-value">Director</span>
                  <span class="approach-stat-label">MilkyWay</span>
                </div>
              </div>

              <div class="approach-credibility">
                <span class="approach-credibility-label">Previously at</span>
                <div class="approach-firms">
                  <span>Deloitte</span>
                  <span aria-hidden="true">·</span>
                  <span>Bank of America</span>
                </div>
              </div>

              <a class="approach-cta" href="#contact">
                Get in touch <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </section>

        <section class="section media-section" id="media">
          <article class="skills-card" aria-labelledby="media-title">
            <header class="skills-card-header">
              <span class="kicker">Skills &amp; interests</span>
              <h2 class="section-title" id="media-title">Ideas informed by theory and research.</h2>
            </header>

            <div class="skills-list">
              {mediaItems.map((item) => (
                <article class="skills-item">
                  <span class="tag">{item.category}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </article>
              ))}
            </div>
          </article>
        </section>

        <section class="contact-panel" id="contact" aria-label="Connect with Anchit Goyal">
          <div class="contact-copy">
            <span class="kicker">Connect</span>
            <h2>Let’s start a conversation.</h2>

            <dl class="contact-meta">
              <div>
                <dt>Industry</dt>
                <dd>Management consulting</dd>
              </div>
              <div>
                <dt>Education</dt>
                <dd>Economics and Management, LSE</dd>
              </div>
            </dl>

            <section class="contact-companies" aria-label="Companies">
              <span class="contact-companies-label">Companies</span>
              <div class="company-name-list">
                {partnerLogos.map((logo) => <span>{logo.name}</span>)}
              </div>
            </section>
          </div>

          <form class="contact-form" data-contact-form>
            <div class="field-row">
              <label>
                Name
                <input type="text" name="name" placeholder="Your name" autocomplete="name" required />
              </label>
              <label>
                Email
                <input type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
              </label>
            </div>

            <div class="field-row">
              <label>
                Phone
                <input type="tel" name="phone" placeholder="Optional" autocomplete="tel" />
              </label>
              <label>
                Company
                <input type="text" name="company" placeholder="Company name" autocomplete="organization" />
              </label>
            </div>

            <label>
              Enquiry subject
              <input type="text" name="subject" placeholder="Professional enquiry" required />
            </label>

            <label>
              Message
              <textarea name="message" placeholder="Tell us about your enquiry" required></textarea>
            </label>

            <button type="submit">Send Enquiry</button>
          </form>
        </section>

        <footer class="footer">
          <div class="footer-details">
            <a class="footer-website" href="https://www.voltare.in/" target="_blank" rel="noopener noreferrer">
              Voltare · voltare.in <span aria-hidden="true">↗</span>
            </a>
            <nav class="footer-socials" aria-label="Social profiles">
              <a
                class="footer-social-link"
                href="https://www.linkedin.com/in/anchit-goyal/"
                aria-label="Visit Anchit Goyal on LinkedIn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 9v10M5 5.5v.01M10 19v-6a3 3 0 0 1 6 0v6M10 10v9" />
                </svg>
              </a>
              <a
                class="footer-social-link"
                href="https://www.instagram.com/goyalanchit/"
                aria-label="Visit Anchit Goyal on Instagram"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle class="instagram-dot" cx="17.5" cy="6.5" r="1" />
                </svg>
              </a>
            </nav>
          </div>
        </footer>
      </div>
    </main>
  </div>
</Layout>

<script>
  if (
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.14 },
    );

    document.documentElement.classList.add('has-scroll-reveal');
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => {
      revealObserver.observe(element);
    });
  }

  document.querySelectorAll('.mobile-nav-links a').forEach((link) => {
    link.addEventListener('click', () => {
      link.closest('details')?.removeAttribute('open');
    });
  });

  document.querySelector<HTMLFormElement>('[data-contact-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();

    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    const formData = new FormData(form);
    const name = String(formData.get('name') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();
    const phone = String(formData.get('phone') ?? '').trim();
    const company = String(formData.get('company') ?? '').trim();
    const subject = String(formData.get('subject') ?? '').trim();
    const message = String(formData.get('message') ?? '').trim();
    const body = [
      `Name: ${name}`,
      `Email: ${email}`,
      `Phone: ${phone || 'Not provided'}`,
      `Company: ${company || 'Not provided'}`,
      '',
      'Message:',
      message,
    ].join('\n');

    const gmailComposeUrl = new URL('https://mail.google.com/mail/');
    gmailComposeUrl.searchParams.set('view', 'cm');
    gmailComposeUrl.searchParams.set('fs', '1');
    gmailComposeUrl.searchParams.set('to', 'anchitgoyal@voltare.in');
    gmailComposeUrl.searchParams.set('su', subject);
    gmailComposeUrl.searchParams.set('body', body);

    window.open(gmailComposeUrl.toString(), '_blank', 'noopener,noreferrer');
  });

  let loaderDismissed = false;
  const dismissLoader = () => {
    if (loaderDismissed) return;
    loaderDismissed = true;

    const startedAt = Number(document.documentElement.dataset.loaderStarted);
    const elapsed = Number.isFinite(startedAt) ? performance.now() - startedAt : 0;
    const delay = Math.max(0, 1600 - elapsed);

    window.setTimeout(() => {
      document.documentElement.classList.remove('site-loading');
      document.documentElement.classList.add('site-ready');
      document.querySelector('#site-loader')?.setAttribute('aria-hidden', 'true');
    }, delay);
  };

  if (document.readyState === 'complete') {
    dismissLoader();
  } else {
    window.addEventListener('load', dismissLoader, { once: true });
  }

  window.setTimeout(dismissLoader, 7000);
</script>
