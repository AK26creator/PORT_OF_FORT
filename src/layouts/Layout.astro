---
import '../styles/global.css';

const {
  title = 'Anchit Goyal | Analyst',
  description =
    'Anchit Goyal is an experienced analyst with a background in management consulting and a First-Class Honours degree in Economics and Management from LSE.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('site-loading');
      document.documentElement.dataset.loaderStarted = String(performance.now());
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
